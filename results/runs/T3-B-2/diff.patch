+def _builtin_extension_class(name: str) -> type[Extension] | None:
+    """ Return a built-in extension class matching `name`, if one exists.
+
+    Used so a class such as `TaskListExtension` can be loaded by name when
+    entry-point metadata is not installed. Names that are not class-shaped
+    return `None` without importing extension modules.
+    """
+    if not name.endswith('Extension') or not name[0].isupper() or not name.isidentifier():
+        return None
+
+    import pkgutil
+    import markdown.extensions as extensions_pkg
+
+    for info in pkgutil.iter_modules(extensions_pkg.__path__):
+        module = importlib.import_module(f'{extensions_pkg.__name__}.{info.name}')
+        cls = getattr(module, name, None)
+        if (
+            isinstance(cls, type)
+            and issubclass(cls, Extension)
+            and cls.__module__ == module.__name__
+        ):
+            logger.debug(
+                'Successfully imported extension class "%s.%s".' % (cls.__module__, cls.__name__)
+            )
+            return cls
+    return None
+
