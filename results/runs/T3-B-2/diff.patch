diff --git a/markdown/extensions/tasklist.py b/markdown/extensions/tasklist.py
new file mode 100644
index 0000000..435b68b
--- /dev/null
+++ b/markdown/extensions/tasklist.py
@@ -0,0 +1,120 @@
+# Task List Extension for Python-Markdown
+# =======================================
+
+# A list item whose text starts with `[ ]`, `[x]`, or `[X]` followed by a
+# space is rendered as a disabled checkbox.
+
+# Copyright 2026 The Python Markdown Project
+
+# License: [BSD](https://opensource.org/licenses/bsd-license.php)
+
+"""
+Add task-list support to Python-Markdown.
+
+A bullet or numbered item whose text starts with `[ ]`, `[x]`, or `[X]` plus a
+space is rendered as a disabled checkbox. The marker is removed and the rest of
+the item is still parsed as Markdown. In a loose list the checkbox is the first
+child of the item's first paragraph.
+"""
+
+from __future__ import annotations
+
+import re
+import xml.etree.ElementTree as etree
+
+from . import Extension
+from ..treeprocessors import Treeprocessor
+
+# `[ ]`, `[x]`, or `[X]`, then a single space. The space stays in the content.
+TASK_RE = re.compile(r'^\[([ xX])\] ')
+
+
+class TaskListTreeprocessor(Treeprocessor):
+    """ Replace task markers at the start of list items with checkboxes. """
+
+    def __init__(self, md, item_class: str):
+        super().__init__(md)
+        self.item_class = item_class
+
+    def run(self, root: etree.Element) -> None:
+        """ Walk every list item, including items in nested lists. """
+        for li in list(root.iter('li')):
+            self._process_item(li)
+
+    def _process_item(self, li: etree.Element) -> None:
+        """ Turn one list item into a task when its text starts with a marker. """
+        parent = self._content_element(li)
+        text = parent.text
+        if not text:
+            return
+        match = TASK_RE.match(text)
+        if match is None:
+            return
+
+        checked = match.group(1) in ('x', 'X')
+        # Drop the bracket marker and keep the separating space with the content.
+        rest = text[3:]
+        checkbox = etree.Element('input')
+        checkbox.set('type', 'checkbox')
+        checkbox.set('disabled', 'disabled')
+        if checked:
+            checkbox.set('checked', 'checked')
+        if rest:
+            checkbox.tail = rest
+        parent.text = None
+        parent.insert(0, checkbox)
+        self._set_item_class(li)
+
+    def _content_element(self, li: etree.Element) -> etree.Element:
+        """ Return the element whose text is the start of the item.
+
+        A loose item keeps that text in its first paragraph. A tight item keeps
+        it on the ``li`` itself, including when a nested list follows.
+        """
+        if li.text and li.text.strip():
+            return li
+        if len(li) and li[0].tag == 'p':
+            return li[0]
+        return li
+
+    def _set_item_class(self, li: etree.Element) -> None:
+        """ Set the configured class on the list item. """
+        item_class = self.item_class
+        if not item_class:
+            return
+        existing = li.get('class')
+        if not existing:
+            li.set('class', item_class)
+            return
+        if item_class not in existing.split():
+            li.set('class', f'{existing} {item_class}')
+
+
+class TaskListExtension(Extension):
+    """ Add task lists to Markdown. """
+
+    def __init__(self, **kwargs):
+        self.config = {
+            'item_class': ['task-list-item', 'CSS class for a task list item.'],
+        }
+        """ Default configuration options. """
+        super().__init__(**kwargs)
+
+    def extendMarkdown(self, md):
+        """ Register the processor.
+
+        Runs before inline patterns so the marker is not parsed as a link and
+        the remainder of the item is still rendered as Markdown.
+
+        | Class Instance | Registry | Name | Priority |
+        | --- | --- | --- | --- |
+        | `TaskListTreeprocessor` | `treeprocessors` | `tasklist` | `25` |
+
+        """
+        processor = TaskListTreeprocessor(md, self.getConfig('item_class'))
+        md.treeprocessors.register(processor, 'tasklist', 25)
+
+
+def makeExtension(**kwargs):  # pragma: no cover
+    """ Return an instance of `TaskListExtension`. """
+    return TaskListExtension(**kwargs)
