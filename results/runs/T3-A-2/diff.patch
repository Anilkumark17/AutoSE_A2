diff --git a/markdown/extensions/tasklist.py b/markdown/extensions/tasklist.py
new file mode 100644
index 0000000..95dde0a
--- /dev/null
+++ b/markdown/extensions/tasklist.py
@@ -0,0 +1,105 @@
+# Task List Extension for Python-Markdown
+# =======================================
+
+# Adds GitHub-style task lists. A list item whose text starts with `[ ]`,
+# `[x]`, or `[X]` followed by a space becomes a disabled checkbox.
+
+# Copyright 2026 The Python Markdown Project
+
+# License: [BSD](https://opensource.org/licenses/bsd-license.php)
+
+"""
+Add task-list support to Python-Markdown.
+
+A bullet or numbered item whose text starts with `[ ]`, `[x]`, or `[X]` plus a
+space is rendered as a disabled checkbox.
+"""
+
+from __future__ import annotations
+
+import re
+import xml.etree.ElementTree as etree
+
+from . import Extension
+from ..treeprocessors import Treeprocessor
+
+TASK_RE = re.compile(r'^\[([ xX])\] ')
+""" Match a task marker (`[ ]`, `[x]`, or `[X]`) followed by a space. """
+
+
+class TaskListTreeprocessor(Treeprocessor):
+    """ Insert disabled checkboxes for task-list items. """
+
+    def __init__(self, md, item_class: str):
+        super().__init__(md)
+        self.item_class = item_class
+
+    def run(self, root: etree.Element) -> None:
+        """ Walk every list and convert matching items. """
+        for parent in root.iter():
+            if parent.tag not in ('ul', 'ol'):
+                continue
+            for li in list(parent):
+                if li.tag == 'li':
+                    self._handle_item(li)
+
+    def _handle_item(self, li: etree.Element) -> None:
+        """ Convert one list item when its text starts with a task marker. """
+        if li.text and TASK_RE.match(li.text):
+            self._make_task(li, li)
+            return
+        # Loose lists wrap the item text in a paragraph. Only the first
+        # paragraph counts, and only when the item itself has no other text.
+        if li.text and li.text.strip():
+            return
+        if len(li) and li[0].tag == 'p' and li[0].text and TASK_RE.match(li[0].text):
+            self._make_task(li, li[0])
+
+    def _make_task(self, li: etree.Element, container: etree.Element) -> None:
+        """ Remove the marker and insert a checkbox at the start of `container`. """
+        text = container.text
+        if not text:
+            return
+        match = TASK_RE.match(text)
+        if not match:
+            return
+        # Drop `[ ]` / `[x]` / `[X]` and keep the required space plus the rest,
+        # so the checkbox is the first thing in the item content.
+        checkbox = etree.Element('input')
+        checkbox.set('type', 'checkbox')
+        checkbox.set('disabled', 'disabled')
+        if match.group(1) in 'xX':
+            checkbox.set('checked', 'checked')
+        checkbox.tail = text[3:]
+        container.text = None
+        container.insert(0, checkbox)
+        li.set('class', self.item_class)
+
+
+class TaskListExtension(Extension):
+    """ Add task lists to Markdown. """
+
+    def __init__(self, **kwargs):
+        self.config = {
+            'item_class': ['task-list-item', 'Class name added to a task-list item (`li`).'],
+        }
+        """ Default configuration options. """
+        super().__init__(**kwargs)
+
+    def extendMarkdown(self, md):
+        """ Register `TaskListTreeprocessor` as `tasklist` at priority `16`.
+
+        Priority `16` runs after inline parsing (`20`) and before prettify (`10`),
+        so Markdown in the rest of the item is already rendered.
+
+        """
+        md.treeprocessors.register(
+            TaskListTreeprocessor(md, self.getConfig('item_class')),
+            'tasklist',
+            16,
+        )
+
+
+def makeExtension(**kwargs):  # pragma: no cover
+    """ Return an instance of the `TaskListExtension`. """
+    return TaskListExtension(**kwargs)
