diff --git a/markdown/extensions/admonition.py b/markdown/extensions/admonition.py
index 37a7136..cb41e20 100644
--- a/markdown/extensions/admonition.py
+++ b/markdown/extensions/admonition.py
@@ -59,7 +59,9 @@ class AdmonitionProcessor(BlockProcessor):
 
     CLASSNAME = 'admonition'
     CLASSNAME_TITLE = 'admonition-title'
-    RE = re.compile(r'(?:^|\n)!!! ?([\w\-]+(?: +[\w\-]+)*)(?: +"(.*?)")? *(?:\n|$)')
+    # `!!!` renders a `<div>`; `???` renders a collapsible `<details>`.
+    # Capture groups stay (classes, title) so both markers share title rules.
+    RE = re.compile(r'(?:^|\n)(?:!!!|\?\?\?) ?([\w\-]+(?: +[\w\-]+)*)(?: +"(.*?)")? *(?:\n|$)')
     RE_SPACES = re.compile('  +')
 
     def __init__(self, parser: blockparser.BlockParser):
@@ -91,7 +93,10 @@ class AdmonitionProcessor(BlockProcessor):
 
         sibling = self.lastChild(parent)
 
-        if sibling is None or sibling.tag != 'div' or sibling.get('class', '').find(self.CLASSNAME) == -1:
+        if (
+            sibling is None or sibling.tag not in ('div', 'details') or
+            sibling.get('class', '').find(self.CLASSNAME) == -1
+        ):
             sibling = None
         else:
             # If the last child is a list and the content is sufficiently indented
@@ -149,10 +154,15 @@ class AdmonitionProcessor(BlockProcessor):
 
         if m:
             klass, title = self.get_class_and_title(m)
-            div = etree.SubElement(parent, 'div')
+            if m.group(0).lstrip('\n').startswith('???'):
+                div = etree.SubElement(parent, 'details')
+                title_tag = 'summary'
+            else:
+                div = etree.SubElement(parent, 'div')
+                title_tag = 'p'
             div.set('class', '{} {}'.format(self.CLASSNAME, klass))
             if title:
-                p = etree.SubElement(div, 'p')
+                p = etree.SubElement(div, title_tag)
                 p.text = title
                 p.set('class', self.CLASSNAME_TITLE)
         else:
@@ -180,10 +190,13 @@ class AdmonitionProcessor(BlockProcessor):
             # no title was provided, use the capitalized class name as title
             # e.g.: `!!! note` will render
             # `<p class="admonition-title">Note</p>`
+            # and `??? note` will render
+            # `<summary class="admonition-title">Note</summary>`
             title = klass.split(' ', 1)[0].capitalize()
         elif title == '':
             # an explicit blank title should not be rendered
             # e.g.: `!!! warning ""` will *not* render `p` with a title
+            # and `??? warning ""` will *not* render `summary`
             title = None
         return klass, title
 
