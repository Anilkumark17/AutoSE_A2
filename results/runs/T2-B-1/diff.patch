diff --git a/tests/test_syntax/extensions/test_admonition.py b/tests/test_syntax/extensions/test_admonition.py
index 268633d..9dd6e54 100644
--- a/tests/test_syntax/extensions/test_admonition.py
+++ b/tests/test_syntax/extensions/test_admonition.py
@@ -263,3 +263,111 @@ class TestAdmonition(TestCase):
             ),
             extensions=['admonition']
         )
+
+    def test_collapsible_defaults_and_titles(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                ??? note
+                    A *normal* paragraph here
+
+                    1. first
+                    2. second
+
+                ??? Note "Did you know?"
+                    You can customize the title
+                Not part of an Admonition!
+
+                ??? class1 class2    class3 "And now..."
+                    Several class names can be separated by space chars.
+
+                ??? note anotherclass
+                    The default title is the capitalized first class name.
+
+                ??? tip ""
+                    An explicitly empty string prevents the title from being rendered.
+                '''
+            ),
+            self.dedent(
+                '''
+                <details class="admonition note">
+                <summary class="admonition-title">Note</summary>
+                <p>A <em>normal</em> paragraph here</p>
+                <ol>
+                <li>first</li>
+                <li>second</li>
+                </ol>
+                </details>
+                <details class="admonition note">
+                <summary class="admonition-title">Did you know?</summary>
+                <p>You can customize the title</p>
+                </details>
+                <p>Not part of an Admonition!</p>
+                <details class="admonition class1 class2 class3">
+                <summary class="admonition-title">And now...</summary>
+                <p>Several class names can be separated by space chars.</p>
+                </details>
+                <details class="admonition note anotherclass">
+                <summary class="admonition-title">Note</summary>
+                <p>The default title is the capitalized first class name.</p>
+                </details>
+                <details class="admonition tip">
+                <p>An explicitly empty string prevents the title from being rendered.</p>
+                </details>
+                '''
+            ),
+            extensions=['admonition']
+        )
+
+    def test_collapsible_later_block_and_nested(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                !!! note
+                    A regular admonition.
+
+                ??? warning
+                    First paragraph.
+
+                    Still in the disclosure with *emphasis*.
+
+                    !!! note
+                        Nested regular admonition.
+
+                    ??? tip "Nested"
+                        - one
+                        - two
+
+                        inner second
+
+                    Still in the outer disclosure.
+                '''
+            ),
+            self.dedent(
+                '''
+                <div class="admonition note">
+                <p class="admonition-title">Note</p>
+                <p>A regular admonition.</p>
+                </div>
+                <details class="admonition warning">
+                <summary class="admonition-title">Warning</summary>
+                <p>First paragraph.</p>
+                <p>Still in the disclosure with <em>emphasis</em>.</p>
+                <div class="admonition note">
+                <p class="admonition-title">Note</p>
+                <p>Nested regular admonition.</p>
+                </div>
+                <details class="admonition tip">
+                <summary class="admonition-title">Nested</summary>
+                <ul>
+                <li>one</li>
+                <li>two</li>
+                </ul>
+                <p>inner second</p>
+                </details>
+                <p>Still in the outer disclosure.</p>
+                </details>
+                '''
+            ),
+            extensions=['admonition']
+        )
