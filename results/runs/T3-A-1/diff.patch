@@ -0,0 +1,211 @@
+"""Tests for the tasklist extension."""
+
+from markdown.extensions.tasklist import TaskListExtension
+from markdown.test_tools import TestCase
+
+
+class TestTaskList(TestCase):
+
+    default_kwargs = {'extensions': ['tasklist']}
+    maxDiff = None
+
+    def test_tight_list_xhtml_and_html(self):
+        source = self.dedent(
+            """
+            - [ ] unchecked
+            - [x] checked
+            - [X] upper
+            - plain
+            - [ ]no space
+            - [y] no
+            - [] no
+            - [ x] no
+            """
+        )
+        self.assertMarkdownRenders(
+            source,
+            self.dedent(
+                """
+                <ul>
+                <li class="task-list-item"><input disabled="disabled" type="checkbox" /> unchecked</li>
+                <li class="task-list-item"><input checked="checked" disabled="disabled" type="checkbox" /> checked</li>
+                <li class="task-list-item"><input checked="checked" disabled="disabled" type="checkbox" /> upper</li>
+                <li>plain</li>
+                <li>[ ]no space</li>
+                <li>[y] no</li>
+                <li>[] no</li>
+                <li>[ x] no</li>
+                </ul>
+                """
+            ),
+            output_format='xhtml',
+        )
+        self.assertMarkdownRenders(
+            source,
+            self.dedent(
+                """
+                <ul>
+                <li class="task-list-item"><input disabled type="checkbox"> unchecked</li>
+                <li class="task-list-item"><input checked disabled type="checkbox"> checked</li>
+                <li class="task-list-item"><input checked disabled type="checkbox"> upper</li>
+                <li>plain</li>
+                <li>[ ]no space</li>
+                <li>[y] no</li>
+                <li>[] no</li>
+                <li>[ x] no</li>
+                </ul>
+                """
+            ),
+            output_format='html',
+        )
+
+    def test_ordered_list(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                1. [ ] one
+                2. [x] two
+                """
+            ),
+            '<ol>\n'
+            '<li class="task-list-item"><input disabled="disabled" type="checkbox" /> one</li>\n'
+            '<li class="task-list-item"><input checked="checked" disabled="disabled" type="checkbox" /> two</li>\n'
+            '</ol>'
+        )
+
+    def test_loose_list_checkbox_in_first_paragraph(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                - [ ] loose item
+
+                    second para
+
+                - [x] done
+                """
+            ),
+            self.dedent(
+                """
+                <ul>
+                <li class="task-list-item">
+                <p><input disabled="disabled" type="checkbox" /> loose item</p>
+                <p>second para</p>
+                </li>
+                <li class="task-list-item">
+                <p><input checked="checked" disabled="disabled" type="checkbox" /> done</p>
+                </li>
+                </ul>
+                """
+            ),
+        )
+
+    def test_nested_lists(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                - [ ] parent
+                    - [x] child
+                    - plain
+                """
+            ),
+            '<ul>\n'
+            '<li class="task-list-item"><input disabled="disabled" type="checkbox" /> parent<ul>\n'
+            '<li class="task-list-item"><input checked="checked" disabled="disabled" type="checkbox" /> child</li>\n'
+            '<li>plain</li>\n'
+            '</ul>\n'
+            '</li>\n'
+            '</ul>'
+        )
+
+    def test_markdown_in_item_is_rendered(self):
+        self.assertMarkdownRenders(
+            '- [x] **bold** and *em* and `code` and [link](http://example.com)',
+            '<ul>\n'
+            '<li class="task-list-item"><input checked="checked" disabled="disabled" type="checkbox" /> '
+            '<strong>bold</strong> and <em>em</em> and <code>code</code> and '
+            '<a href="http://example.com">link</a></li>\n'
+            '</ul>'
+        )
+
+    def test_marker_outside_list_is_unchanged(self):
+        self.assertMarkdownRenders(
+            'A paragraph with [x] and [ ] in it.',
+            '<p>A paragraph with [x] and [ ] in it.</p>'
+        )
+
+    def test_marker_not_at_start_of_item(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                - foo
+
+                    [ ] not the start
+                """
+            ),
+            '<ul>\n'
+            '<li>\n'
+            '<p>foo</p>\n'
+            '<p>[ ] not the start</p>\n'
+            '</li>\n'
+            '</ul>'
+        )
+
+    def test_escaped_marker_is_not_a_task(self):
+        self.assertMarkdownRenders(
+            '- \\[ ] not a task\n- [ ] real',
+            '<ul>\n'
+            '<li>[ ] not a task</li>\n'
+            '<li class="task-list-item"><input disabled="disabled" type="checkbox" /> real</li>\n'
+            '</ul>'
+        )
+
+    def test_reference_link_does_not_consume_marker(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                [x]: http://example.com
+
+                - [x] something
+                """
+            ),
+            '<ul>\n'
+            '<li class="task-list-item"><input checked="checked" disabled="disabled" type="checkbox" /> '
+            'something</li>\n'
+            '</ul>'
+        )
+
+    def test_item_class_config(self):
+        source = '- [ ] a\n- [x] b'
+        expected = (
+            '<ul>\n'
+            '<li class="todo"><input disabled="disabled" type="checkbox" /> a</li>\n'
+            '<li class="todo"><input checked="checked" disabled="disabled" type="checkbox" /> b</li>\n'
+            '</ul>'
+        )
+        self.assertMarkdownRenders(
+            source,
+            expected,
+            extensions=['tasklist'],
+            extension_configs={'tasklist': {'item_class': 'todo'}},
+        )
+        self.assertMarkdownRenders(
+            source,
+            expected,
+            extensions=[TaskListExtension(item_class='todo')],
+        )
+        self.assertMarkdownRenders(
+            source,
+            expected,
+            extensions=['markdown.extensions.tasklist'],
+            extension_configs={
+                'markdown.extensions.tasklist': {'item_class': 'todo'}
+            },
+        )
+        self.assertMarkdownRenders(
+            source,
+            expected,
+            extensions=['markdown.extensions.tasklist:TaskListExtension'],
+            extension_configs={
+                'markdown.extensions.tasklist:TaskListExtension': {'item_class': 'todo'}
+            },
+        )
