diff --git a/markdown/extensions/tasklist.py b/markdown/extensions/tasklist.py
new file mode 100644
index 0000000..4283542
--- /dev/null
+++ b/markdown/extensions/tasklist.py
@@ -0,0 +1,105 @@
+# Task List Extension for Python-Markdown
+# =======================================
+
+# Convert `[ ]`, `[x]`, and `[X]` list markers into disabled checkboxes.
+
+# License: [BSD](https://opensource.org/licenses/bsd-license.php)
+
+"""
+Task lists for Python-Markdown.
+
+A bullet or numbered item whose text starts with `[ ]`, `[x]`, or `[X]`
+followed by a space is rendered as a task. The marker is removed and a
+disabled checkbox is inserted at the start of the item. In a loose list the
+checkbox is the first child of the item's first paragraph.
+"""
+
+from __future__ import annotations
+
+import re
+import xml.etree.ElementTree as etree
+from typing import TYPE_CHECKING
+
+from . import Extension
+from ..treeprocessors import Treeprocessor
+
+if TYPE_CHECKING:  # pragma: no cover
+    from markdown import Markdown
+
+
+# Bracket marker plus the required following space. The space stays in the item.
+_TASK_RE = re.compile(r'^\[([ xX])\] ')
+
+
+class TaskListTreeprocessor(Treeprocessor):
+    """ Replace task markers in list items with disabled checkboxes. """
+
+    def __init__(self, md: Markdown, extension: TaskListExtension):
+        super().__init__(md)
+        self.extension = extension
+
+    def run(self, root: etree.Element) -> None:
+        """ Walk every list item and convert those that start with a task marker. """
+        item_class = self.extension.getConfig('item_class')
+        for li in list(root.iter('li')):
+            if self._taskify(li):
+                self._set_item_class(li, item_class)
+                continue
+            # Loose item: the marker lives in the first paragraph, not on the `li`.
+            if (not li.text or not li.text.strip()) and len(li) and li[0].tag == 'p':
+                if self._taskify(li[0]):
+                    self._set_item_class(li, item_class)
+
+    def _taskify(self, elem: etree.Element) -> bool:
+        """ Turn a leading task marker into a checkbox. Return whether it matched. """
+        text = elem.text
+        if not text:
+            return False
+        match = _TASK_RE.match(text)
+        if match is None:
+            return False
+
+        checkbox = etree.Element('input')
+        checkbox.set('type', 'checkbox')
+        checkbox.set('disabled', 'disabled')
+        if match.group(1) in ('x', 'X'):
+            checkbox.set('checked', 'checked')
+        # Drop the bracket marker and keep the separating space plus the rest,
+        # which inline patterns still need to render.
+        checkbox.tail = text[match.end() - 1:]
+        elem.text = None
+        elem.insert(0, checkbox)
+        return True
+
+    @staticmethod
+    def _set_item_class(li: etree.Element, item_class: str) -> None:
+        if item_class:
+            li.set('class', item_class)
+
+
+class TaskListExtension(Extension):
+    """ Add task-list checkboxes to Markdown. """
+
+    def __init__(self, **kwargs):
+        self.config = {
+            'item_class': [
+                'task-list-item',
+                'CSS class set on each task `li`. Default: `task-list-item`.',
+            ],
+        }
+        super().__init__(**kwargs)
+
+    def extendMarkdown(self, md):
+        """ Register `TaskListTreeprocessor` on `treeprocessors` as `tasklist` at priority `25`.
+
+        Priority is above inline processing so the marker is not parsed as a link.
+        The remainder of the item is still rendered as Markdown.
+        """
+        md.treeprocessors.register(
+            TaskListTreeprocessor(md, self), 'tasklist', 25
+        )
+
+
+def makeExtension(**kwargs):  # pragma: no cover
+    """ Return an instance of [`TaskListExtension`][markdown.extensions.tasklist.TaskListExtension]. """
+    return TaskListExtension(**kwargs)
