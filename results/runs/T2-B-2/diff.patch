+    def _is_collapsible(self, match: re.Match[str]) -> bool:
+        """True when the matched marker is ``???`` rather than ``!!!``."""
+
+        text = match.group(0)
+        if text.startswith('\n'):
+            text = text[1:]
+        return text.startswith('???')
+
 
