@@ -263,3 +263,183 @@ class TestAdmonition(TestCase):
             ),
             extensions=['admonition']
         )
+
+
+class TestCollapsibleAdmonition(TestCase):
+
+    def test_default_and_empty_title(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                ??? note
+                    A normal paragraph here
+
+                ??? note anotherclass
+                    The default title is the capitalized first class name.
+
+                ??? tip ""
+                    An explicitly empty string prevents the title from being rendered.
+
+                ??? class1 class2    class3 "And now..."
+                    Several class names can be separated by space chars.
+                '''
+            ),
+            self.dedent(
+                '''
+                <details class="admonition note">
+                <summary class="admonition-title">Note</summary>
+                <p>A normal paragraph here</p>
+                </details>
+                <details class="admonition note anotherclass">
+                <summary class="admonition-title">Note</summary>
+                <p>The default title is the capitalized first class name.</p>
+                </details>
+                <details class="admonition tip">
+                <p>An explicitly empty string prevents the title from being rendered.</p>
+                </details>
+                <details class="admonition class1 class2 class3">
+                <summary class="admonition-title">And now...</summary>
+                <p>Several class names can be separated by space chars.</p>
+                </details>
+                '''
+            ),
+            extensions=['admonition']
+        )
+
+    def test_body_is_markdown(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                ??? note "Mix"
+                    A *word* and a list:
+
+                    - alpha
+                    - beta
+
+                    ??? warning
+
+                        Nested *emphasis*
+                '''
+            ),
+            self.dedent(
+                '''
+                <details class="admonition note">
+                <summary class="admonition-title">Mix</summary>
+                <p>A <em>word</em> and a list:</p>
+                <ul>
+                <li>alpha</li>
+                <li>beta</li>
+                </ul>
+                <details class="admonition warning">
+                <summary class="admonition-title">Warning</summary>
+                <p>Nested <em>emphasis</em></p>
+                </details>
+                </details>
+                '''
+            ),
+            extensions=['admonition']
+        )
+
+    def test_later_indented_block_stays_inside(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                ??? note "Title"
+                    first
+
+                    second
+
+                outside
+                '''
+            ),
+            self.dedent(
+                '''
+                <details class="admonition note">
+                <summary class="admonition-title">Title</summary>
+                <p>first</p>
+                <p>second</p>
+                </details>
+                <p>outside</p>
+                '''
+            ),
+            extensions=['admonition']
+        )
+
+    def test_both_markers_and_nesting(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                !!! note "Outer"
+
+                    ??? warning "Inner"
+
+                        *text*
+
+                    more outer
+
+                ??? tip
+
+                    !!! danger "Nested bang"
+
+                        1. one
+                        2. two
+                '''
+            ),
+            self.dedent(
+                '''
+                <div class="admonition note">
+                <p class="admonition-title">Outer</p>
+                <details class="admonition warning">
+                <summary class="admonition-title">Inner</summary>
+                <p><em>text</em></p>
+                </details>
+                <p>more outer</p>
+                </div>
+                <details class="admonition tip">
+                <summary class="admonition-title">Tip</summary>
+                <div class="admonition danger">
+                <p class="admonition-title">Nested bang</p>
+                <ol>
+                <li>one</li>
+                <li>two</li>
+                </ol>
+                </div>
+                </details>
+                '''
+            ),
+            extensions=['admonition']
+        )
+
+    def test_inside_list(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                - List
+
+                    ??? note "Admontion"
+
+                        - Paragraph
+
+                            Paragraph
+                '''
+            ),
+            self.dedent(
+                '''
+                <ul>
+                <li>
+                <p>List</p>
+                <details class="admonition note">
+                <summary class="admonition-title">Admontion</summary>
+                <ul>
+                <li>
+                <p>Paragraph</p>
+                <p>Paragraph</p>
+                </li>
+                </ul>
+                </details>
+                </li>
+                </ul>
+                '''
+            ),
+            extensions=['admonition']
+        )
