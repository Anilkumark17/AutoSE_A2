diff --git a/tests/test_syntax/extensions/test_admonition.py b/tests/test_syntax/extensions/test_admonition.py
index 268633d..f3da3a9 100644
--- a/tests/test_syntax/extensions/test_admonition.py
+++ b/tests/test_syntax/extensions/test_admonition.py
@@ -263,3 +263,121 @@ class TestAdmonition(TestCase):
             ),
             extensions=['admonition']
         )
+
+    def test_collapsible_titles(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                ??? note
+                    A *normal* paragraph.
+
+                ??? warning ""
+                    No title element.
+
+                ??? tip "Custom title"
+                    Still here.
+                Not part of the disclosure.
+                '''
+            ),
+            self.dedent(
+                '''
+                <details class="admonition note">
+                <summary class="admonition-title">Note</summary>
+                <p>A <em>normal</em> paragraph.</p>
+                </details>
+                <details class="admonition warning">
+                <p>No title element.</p>
+                </details>
+                <details class="admonition tip">
+                <summary class="admonition-title">Custom title</summary>
+                <p>Still here.</p>
+                </details>
+                <p>Not part of the disclosure.</p>
+                '''
+            ),
+            extensions=['admonition']
+        )
+
+    def test_collapsible_later_block_and_nested(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                ??? note
+                    First paragraph.
+
+                    - one
+                    - two
+
+                    Still inside.
+
+                    !!! warning
+                        Nested *admonition*.
+
+                !!! note
+                    ??? tip "Inner"
+                        A *collapsible* body.
+
+                    Still in the regular admonition.
+                '''
+            ),
+            self.dedent(
+                '''
+                <details class="admonition note">
+                <summary class="admonition-title">Note</summary>
+                <p>First paragraph.</p>
+                <ul>
+                <li>one</li>
+                <li>two</li>
+                </ul>
+                <p>Still inside.</p>
+                <div class="admonition warning">
+                <p class="admonition-title">Warning</p>
+                <p>Nested <em>admonition</em>.</p>
+                </div>
+                </details>
+                <div class="admonition note">
+                <p class="admonition-title">Note</p>
+                <details class="admonition tip">
+                <summary class="admonition-title">Inner</summary>
+                <p>A <em>collapsible</em> body.</p>
+                </details>
+                <p>Still in the regular admonition.</p>
+                </div>
+                '''
+            ),
+            extensions=['admonition']
+        )
+
+    def test_collapsible_in_list(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                '''
+                - List
+
+                    ??? note "Admontion"
+
+                        - Paragraph
+
+                            Paragraph
+                '''
+            ),
+            self.dedent(
+                '''
+                <ul>
+                <li>
+                <p>List</p>
+                <details class="admonition note">
+                <summary class="admonition-title">Admontion</summary>
+                <ul>
+                <li>
+                <p>Paragraph</p>
+                <p>Paragraph</p>
+                </li>
+                </ul>
+                </details>
+                </li>
+                </ul>
+                '''
+            ),
+            extensions=['admonition']
+        )
